@@ -0,0 +1,298 @@
+# SPDX-FileCopyrightText: Copyright (c) 2025 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+"""Tests for slime/utils/env_balanced_sampling.py.
+
+The contract: given an unbalanced prompt pool and a per-env weights dict,
+every call to ``EnvBalancedSampler.draw(N)`` returns N prompts whose
+env_type distribution matches the weights (to within the exactness of
+largest-remainder rounding).
+
+Tested scenarios:
+  1. Default (no weights) — N/A, module isn't invoked
+  2. Perfectly matched weights + dataset — trivial case works
+  3. Unbalanced dataset (IF-heavy, like RLVR1_v2) + balanced weights —
+     rare envs are up-sampled with bucket cycling
+  4. Weights reference an env with zero samples — fails fast at init
+  5. Samples missing env_type — dropped unless __other__ in weights
+  6. Multiple draw calls + bucket cycling across dataset boundary
+  7. largest-remainder exactness: draw(N) returns EXACTLY N samples
+  8. state_dict round-trip: save/restore per-env cursor state
+"""
+
+from __future__ import annotations
+
+import collections
+import logging
+from types import SimpleNamespace
+from typing import Any, Dict, List
+
+import pytest
+
+from slime.utils.env_balanced_sampling import EnvBalancedSampler
+
+
+def _make_sample(env: str, idx: int = 0) -> SimpleNamespace:
+    return SimpleNamespace(metadata={"env_type": env}, _id=idx)
+
+
+def _make_pool(counts: Dict[str, int]) -> List[SimpleNamespace]:
+    out = []
+    for env, n in counts.items():
+        for i in range(n):
+            out.append(_make_sample(env, idx=i))
+    return out
+
+
+def _count_envs(samples: List[Any]) -> Dict[str, int]:
+    return dict(collections.Counter(s.metadata["env_type"] for s in samples))
+
+
+# ---------------------------------------------------------------------------
+# Basic correctness
+# ---------------------------------------------------------------------------
+
+
+class TestDrawBasicCorrectness:
+    def test_balanced_dataset_balanced_weights(self):
+        pool = _make_pool({"math": 50, "code_gen": 50})
+        sampler = EnvBalancedSampler(pool, {"math": 0.5, "code_gen": 0.5}, seed=0)
+        drawn = sampler.draw(100)
+        assert len(drawn) == 100
+        counts = _count_envs(drawn)
+        assert counts["math"] == 50
+        assert counts["code_gen"] == 50
+
+    def test_unbalanced_dataset_balanced_weights_upsamples_rare(self):
+        """IF-heavy dataset (mirrors RLVR1_v2) — balanced weights should
+        force each draw to contain equal per-env counts even though IF
+        dominates the dataset 2:1."""
+        pool = _make_pool({
+            "instruction_following": 100,
+            "math": 10,
+            "code_gen": 10,
+        })
+        sampler = EnvBalancedSampler(
+            pool,
+            {"instruction_following": 1/3, "math": 1/3, "code_gen": 1/3},
+            seed=0,
+        )
+        drawn = sampler.draw(90)
+        counts = _count_envs(drawn)
+        assert counts["instruction_following"] == 30
+        assert counts["math"] == 30
+        assert counts["code_gen"] == 30
+
+    def test_draw_returns_exactly_n_samples(self):
+        """Largest-remainder method must give exact counts even when
+        fractions don't divide evenly."""
+        pool = _make_pool({"a": 50, "b": 50, "c": 50})
+        # 7/3 = 2.33 each — remainders must be distributed.
+        sampler = EnvBalancedSampler(pool, {"a": 1, "b": 1, "c": 1}, seed=0)
+        drawn = sampler.draw(7)
+        assert len(drawn) == 7
+        # Expect [3,2,2] or permutation — floors 2,2,2 + 1 leftover.
+        counts = _count_envs(drawn)
+        assert sorted(counts.values()) == [2, 2, 3]
+
+    def test_weights_renormalize(self):
+        """User provides raw counts (not fractions) — should still work."""
+        pool = _make_pool({"a": 100, "b": 100})
+        sampler = EnvBalancedSampler(pool, {"a": 3, "b": 1}, seed=0)
+        drawn = sampler.draw(100)
+        counts = _count_envs(drawn)
+        assert counts["a"] == 75
+        assert counts["b"] == 25
+
+
+# ---------------------------------------------------------------------------
+# Error and edge cases
+# ---------------------------------------------------------------------------
+
+
+class TestErrors:
+    def test_empty_weights_rejected(self):
+        pool = _make_pool({"a": 10})
+        with pytest.raises(ValueError, match="non-empty"):
+            EnvBalancedSampler(pool, {}, seed=0)
+
+    def test_zero_total_weight_rejected(self):
+        pool = _make_pool({"a": 10})
+        with pytest.raises(ValueError, match="positive"):
+            EnvBalancedSampler(pool, {"a": 0, "b": 0}, seed=0)
+
+    def test_weight_references_missing_env(self):
+        """If weights mention an env but dataset has zero samples of it,
+        fail at init, don't silently return short batches."""
+        pool = _make_pool({"math": 10})
+        with pytest.raises(ValueError, match="zero matching"):
+            EnvBalancedSampler(pool, {"math": 0.5, "code_gen": 0.5}, seed=0)
+
+    def test_draw_zero_returns_empty(self):
+        pool = _make_pool({"a": 10})
+        sampler = EnvBalancedSampler(pool, {"a": 1.0}, seed=0)
+        assert sampler.draw(0) == []
+
+    def test_draw_negative_returns_empty(self):
+        pool = _make_pool({"a": 10})
+        sampler = EnvBalancedSampler(pool, {"a": 1.0}, seed=0)
+        assert sampler.draw(-5) == []
+
+
+# ---------------------------------------------------------------------------
+# Bucket cycling (target > bucket size)
+# ---------------------------------------------------------------------------
+
+
+class TestBucketCycling:
+    def test_target_exceeds_bucket_size_cycles_with_replacement(self):
+        """When weights demand more samples of env X than exist in its
+        bucket, the sampler cycles through the bucket (with a reshuffle
+        each full pass)."""
+        pool = _make_pool({"rare": 5, "common": 1000})
+        sampler = EnvBalancedSampler(pool, {"rare": 0.5, "common": 0.5}, seed=0)
+        drawn = sampler.draw(100)
+        counts = _count_envs(drawn)
+        assert counts["rare"] == 50  # drew 50 from a bucket of 5 → 10× cycled
+        assert counts["common"] == 50
+
+    def test_cycling_preserves_diversity_within_cycle(self):
+        """Within a single cycle (bucket_size consecutive draws), each
+        sample in the bucket is used exactly once."""
+        pool = _make_pool({"a": 5, "b": 5})
+        sampler = EnvBalancedSampler(pool, {"a": 0.5, "b": 0.5}, seed=0)
+        # Draw exactly 5+5=10 samples — one full pass per bucket.
+        drawn = sampler.draw(10, shuffle_output=False)
+        a_samples = [s._id for s in drawn if s.metadata["env_type"] == "a"]
+        assert sorted(a_samples) == [0, 1, 2, 3, 4]  # each used once
+
+    def test_multiple_draws_accumulate_to_target(self):
+        """Over many small draws, the long-run distribution converges on
+        the target weights."""
+        pool = _make_pool({"a": 100, "b": 100})
+        sampler = EnvBalancedSampler(pool, {"a": 0.7, "b": 0.3}, seed=0)
+        total = collections.Counter()
+        for _ in range(100):
+            for s in sampler.draw(10):
+                total[s.metadata["env_type"]] += 1
+        # 1000 total; expect 700/300 exactly (LR method always hits targets).
+        assert total["a"] == 700
+        assert total["b"] == 300
+
+
+# ---------------------------------------------------------------------------
+# Other-env bucket handling
+# ---------------------------------------------------------------------------
+
+
+class TestOtherEnvBucket:
+    def test_unknown_env_dropped_by_default(self, caplog):
+        pool = _make_pool({"math": 10, "weird_unknown": 20})
+        with caplog.at_level(logging.WARNING):
+            sampler = EnvBalancedSampler(pool, {"math": 1.0}, seed=0)
+        drawn = sampler.draw(20)
+        # All math because weird_unknown was dropped.
+        assert all(s.metadata["env_type"] == "math" for s in drawn)
+        assert any("unrecognized env_type" in r.message for r in caplog.records)
+
+    def test_unknown_env_included_via_other_key(self):
+        pool = _make_pool({"math": 10, "weird_unknown": 10, "another_weird": 10})
+        sampler = EnvBalancedSampler(
+            pool,
+            {"math": 0.5, "__other__": 0.5},
+            seed=0,
+        )
+        drawn = sampler.draw(20)
+        counts = _count_envs(drawn)
+        assert counts["math"] == 10
+        # The 10 __other__ slots come from the weird_unknown + another_weird pool.
+        other = [s for s in drawn if s.metadata["env_type"] in {"weird_unknown", "another_weird"}]
+        assert len(other) == 10
+
+
+# ---------------------------------------------------------------------------
+# Reproducibility + state
+# ---------------------------------------------------------------------------
+
+
+class TestReproducibility:
+    def test_same_seed_same_output(self):
+        pool = _make_pool({"a": 30, "b": 30})
+        s1 = EnvBalancedSampler(pool, {"a": 0.5, "b": 0.5}, seed=42)
+        s2 = EnvBalancedSampler(pool, {"a": 0.5, "b": 0.5}, seed=42)
+        out1 = s1.draw(50)
+        out2 = s2.draw(50)
+        assert [s._id for s in out1] == [s._id for s in out2]
+        assert [s.metadata["env_type"] for s in out1] == [s.metadata["env_type"] for s in out2]
+
+    def test_different_seed_different_output(self):
+        pool = _make_pool({"a": 100, "b": 100})
+        s1 = EnvBalancedSampler(pool, {"a": 0.5, "b": 0.5}, seed=1)
+        s2 = EnvBalancedSampler(pool, {"a": 0.5, "b": 0.5}, seed=2)
+        out1 = s1.draw(50)
+        out2 = s2.draw(50)
+        # Same counts but different order / different specific samples.
+        assert [s._id for s in out1] != [s._id for s in out2]
+
+    def test_state_dict_roundtrip(self):
+        pool = _make_pool({"a": 20, "b": 20})
+        s1 = EnvBalancedSampler(pool, {"a": 0.5, "b": 0.5}, seed=42)
+        _ = s1.draw(20)  # advance cursors
+        state = s1.state_dict()
+
+        # New sampler with same config + same seed — loaded state should
+        # resume from where s1 left off.
+        s2 = EnvBalancedSampler(pool, {"a": 0.5, "b": 0.5}, seed=42)
+        s2.load_state_dict(state)
+        assert s2._offset == s1._offset
+        assert s2._order == s1._order
+
+
+# ---------------------------------------------------------------------------
+# Integration-ish: simulates a 7-env RLVR1_v2-style dataset
+# ---------------------------------------------------------------------------
+
+
+class TestRLVRStyleScenario:
+    def test_rlvr1_v2_mix_balancing(self):
+        """Simulates the actual RLVR1_v2 dataset ratios (IF-dominated)
+        and confirms that the configured balance is enforced."""
+        # Approximate dataset distribution from analysis:
+        pool = _make_pool({
+            "instruction_following": 19000,
+            "code_gen": 11500,
