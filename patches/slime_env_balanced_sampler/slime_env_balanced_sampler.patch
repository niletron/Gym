+++ b/slime/utils/env_balanced_sampling.py
@@ -0,0 +1,612 @@
+# SPDX-FileCopyrightText: Copyright (c) 2025 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+"""Env-balanced prompt sampling for mixed-environment RLVR runs.
+
+The default ``RolloutDataSource.get_samples(N)`` draws a contiguous slice
+from a single shuffled list of prompts. When the dataset is heavily
+unbalanced (e.g. the RLVR1_v2 mix has instruction_following >> code_gen),
+each rollout batch is dominated by the majority env — and since GRPO/GSPO
+advantages are low-magnitude when the within-group reward is near 0 or 1,
+the bottom-reward environments (math, code_gen) receive proportionally
+less gradient signal per training step.
+
+This module provides an ``EnvBalancedSampler`` that, given a per-env
+target fraction, draws each rollout batch with the configured mix. Each
+env has its own shuffle order and offset pointer, so heavy envs are
+down-weighted and light envs are up-weighted (with bucket cycling when
+the bucket is exhausted). The result is that every rollout batch
+contains approximately the target fractions of each env, regardless of
+how the dataset as a whole is distributed.
+
+Contract:
+
+  * ``EnvBalancedSampler(samples, weights, seed, metadata_key, adaptive=...)`` —
+    construct from a list of Sample objects, a ``{env: fraction}`` dict
+    (fractions should roughly sum to 1.0; the sampler normalizes), an
+    RNG seed, and the key under ``sample.metadata`` that holds the env
+    name. Passing ``adaptive=True`` (plus the EMA/refresh/floor/ceiling
+    knobs) enables adaptive EMA-variance re-weighting — see below.
+  * ``.draw(num_samples)`` — return ``num_samples`` prompts, with per-env
+    counts determined by the largest-remainder method for exactness.
+  * ``.update_rewards({env: mean_reward}, rollout_id)`` — feedback hook.
+    No-op in static mode. In adaptive mode, updates per-env EMA; after
+    warmup + every refresh_interval rollouts, re-derives weights from
+    binary-reward variance (``p * (1-p)``), clamped to [floor, ceiling]
+    and renormalized.
+  * Samples whose metadata does not match any configured env are placed
+    in an "other" bucket; if the weights dict contains an entry for
+    ``"other"`` or ``"__other__"`` they are included at that weight,
+    otherwise they are dropped.
+
+Thread-safety: ``update_rewards`` may be called from a different Ray
+actor than ``draw``. The adaptive state (EMAs, rollout counter, live
+weights) is guarded by a ``threading.Lock``. The static per-env shuffle
+state is not cross-actor — callers must own that.
+
+Pure stdlib. No slime or torch imports. Unit-testable in isolation.
+"""
+
+from __future__ import annotations
+
+import logging
+import random
+import threading
+from typing import Any, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+_OTHER_ENV = "__other__"
+
+# Module-level registry for active samplers. The reward-feedback hook in
+# slime/ray/rollout.py can reach the sampler without needing a direct
+# reference by calling ``get_active_sampler()``. This is a soft fallback —
+# the preferred wiring is via RolloutManager.data_source._env_sampler —
+# but the registry makes the hook safe to invoke even in setups where the
+# data source isn't reachable from the manager (e.g. bespoke agents).
+_active_sampler_ref: Optional["EnvBalancedSampler"] = None
+
+
+def get_active_sampler() -> Optional["EnvBalancedSampler"]:
+    """Return the most recently constructed sampler, or None if there isn't one.
+
+    Used by the reward-feedback hook as a fallback wiring path. Callers
+    should be prepared for None (static mode / no sampler active).
+    """
+    return _active_sampler_ref
+
+
+def _register_active_sampler(sampler: "EnvBalancedSampler") -> None:
+    global _active_sampler_ref
+    _active_sampler_ref = sampler
+
+
+def _clear_active_sampler() -> None:
+    """Test-only helper to reset the module-level registry."""
+    global _active_sampler_ref
+    _active_sampler_ref = None
+
+
+class EnvBalancedSampler:
+    def __init__(
+        self,
+        samples: List[Any],
+        weights: Dict[str, float],
+        seed: int = 42,
+        metadata_key: str = "env_type",
+        *,
+        adaptive: bool = False,
+        ema_alpha: float = 0.9,
+        refresh_interval: int = 10,
+        weight_floor: float = 0.02,
+        weight_ceiling: float = 0.40,
+        warmup: int = 5,
+    ):
+        if not weights:
+            raise ValueError("env-balanced sampler requires a non-empty weights dict")
+
+        # Normalize weights so they sum to 1.0. Allow raw values like {math: 1,
+        # code_gen: 1, ...} for convenience.
+        total = float(sum(weights.values()))
+        if total <= 0:
+            raise ValueError(f"env-balanced weights must sum to a positive number, got {total}")
+        self.weights: Dict[str, float] = {env: w / total for env, w in weights.items()}
+        # Keep the user-provided initial weights verbatim — adaptive mode uses them
+        # during warmup and falls back to them if an env has no EMA signal yet.
+        self._initial_weights: Dict[str, float] = dict(self.weights)
+
+        self._metadata_key = metadata_key
+        self._rng = random.Random(seed)
+
+        # ----- adaptive-mode knobs -----
+        self.adaptive = bool(adaptive)
+        self.ema_alpha = float(ema_alpha)
+        self.refresh_interval = int(refresh_interval)
+        self.weight_floor = float(weight_floor)
+        self.weight_ceiling = float(weight_ceiling)
+        self.warmup = int(warmup)
+
+        if self.adaptive:
+            if not (0.0 <= self.ema_alpha <= 1.0):
+                raise ValueError(f"ema_alpha must be in [0,1], got {self.ema_alpha}")
+            if self.refresh_interval <= 0:
+                raise ValueError(f"refresh_interval must be > 0, got {self.refresh_interval}")
+            if not (0.0 <= self.weight_floor <= self.weight_ceiling <= 1.0):
+                raise ValueError(
+                    f"require 0 <= weight_floor ({self.weight_floor}) <= weight_ceiling "
+                    f"({self.weight_ceiling}) <= 1"
+                )
+            if self.warmup < 0:
+                raise ValueError(f"warmup must be >= 0, got {self.warmup}")
+
+        # EMA of mean reward per env, updated by update_rewards().
+        # None = no signal received yet for this env.
+        self._ema: Dict[str, Optional[float]] = {env: None for env in self.weights}
+        # How many rollouts we have observed update_rewards() for.
+        self._rollout_counter: int = 0
+        # When the last refresh recomputed weights; refresh fires when
+        # (counter - last_refresh) >= refresh_interval, after warmup.
+        self._last_refresh_counter: int = 0
+        # How many adaptive re-weight events have fired.
+        self._refreshes: int = 0
+        # Lock guarding _ema, _rollout_counter, _last_refresh_counter, and
+        # mutations to self.weights. draw() reads self.weights under the lock
+        # via _snapshot_weights() to avoid mid-update tearing. Also guards
+        # the metrics-tracking counters below.
+        self._lock = threading.Lock()
+
+        # ----- draw-tracking counters (for WandB metrics) -----
+        # _last_batch_counts: how many of each env in the most recent draw().
+        # _cumulative_counts: running total per env since init.
+        # _total_draws: number of draw() calls.
+        # _last_batch_size: size of the last draw (0 until first draw).
+        self._last_batch_counts: Dict[str, int] = {env: 0 for env in self.weights}
+        self._cumulative_counts: Dict[str, int] = {env: 0 for env in self.weights}
+        self._total_draws: int = 0
+        self._last_batch_size: int = 0
+
+        # Bucket samples by env_type. Samples whose metadata key is missing or
+        # unrecognized go into __other__; they are included in draws only if
+        # the weights dict has an entry for __other__.
+        self.buckets: Dict[str, List[Any]] = {env: [] for env in self.weights}
+        self._other_bucket: List[Any] = []
+        for s in samples:
+            md = getattr(s, "metadata", None)
+            env = None
+            if isinstance(md, dict):
+                env = md.get(metadata_key)
+            if env in self.buckets:
+                self.buckets[env].append(s)
+            else:
+                self._other_bucket.append(s)
+
+        if _OTHER_ENV in self.weights:
+            self.buckets[_OTHER_ENV] = self._other_bucket
+
+        for env, bucket in self.buckets.items():
+            logger.info(
+                "env_balanced_sampler: env=%s bucket_size=%d target_fraction=%.3f",
+                env, len(bucket), self.weights[env],
+            )
+        if self._other_bucket and _OTHER_ENV not in self.weights:
+            envs_seen = sorted({
+                (s.metadata or {}).get(metadata_key, "<missing>")
+                for s in self._other_bucket
+                if isinstance(getattr(s, "metadata", None), dict)
+            })
+            logger.warning(
+                "env_balanced_sampler: %d samples with unrecognized env_type "
+                "(seen: %s) — DROPPED from rollouts. Add \"__other__\": <weight> "
+                "to --env-sampling-weights to include them.",
+                len(self._other_bucket), envs_seen[:10],
+            )
+
+        # Fail fast if any configured env has an empty bucket.
+        empty = [env for env, b in self.buckets.items() if not b and self.weights.get(env, 0) > 0]
+        if empty:
+            raise ValueError(
+                f"env-balanced sampler: weights reference envs with zero matching "
+                f"samples in the dataset: {empty}. Check --env-sampling-weights vs "
+                f"the prompt_data metadata."
+            )
+
+        # Per-env shuffle order + offset. Each bucket is independently
+        # cycled; when its offset reaches the end, we reshuffle it.
+        self._order: Dict[str, List[int]] = {}
+        self._offset: Dict[str, int] = {}
+        for env in self.buckets:
+            self._reshuffle(env)
+
+        # Register in the module-level registry so slime's reward-feedback
+        # hook can reach this sampler even if it doesn't have a direct
+        # reference. See get_active_sampler().
+        _register_active_sampler(self)
+
+    def _reshuffle(self, env: str) -> None:
+        order = list(range(len(self.buckets[env])))
+        self._rng.shuffle(order)
+        self._order[env] = order
+        self._offset[env] = 0
+
+    def _draw_env(self, env: str, n: int) -> List[Any]:
+        """Draw n samples from env's bucket with cycling + reshuffle."""
+        if n <= 0:
+            return []
+        out: List[Any] = []
+        bucket = self.buckets[env]
+        while len(out) < n:
+            order = self._order[env]
+            off = self._offset[env]
+            take = min(n - len(out), len(order) - off)
+            for i in range(take):
+                out.append(bucket[order[off + i]])
+            self._offset[env] = off + take
+            if self._offset[env] >= len(order):
+                self._reshuffle(env)
+        return out
+
+    def _snapshot_weights(self) -> Dict[str, float]:
+        """Return a thread-safe copy of self.weights.
+
+        Called on every ``draw()`` so concurrent ``update_rewards()`` calls
+        can't tear the weights dict mid-read.
+        """
+        with self._lock:
+            return dict(self.weights)
+
+    def _compute_targets(self, n: int, weights: Optional[Dict[str, float]] = None) -> Dict[str, int]:
+        """Distribute n into per-env integer counts summing exactly to n,
+        using the largest-remainder method. Envs in weights order act as
+        tie-breakers so behavior is deterministic."""
+        if weights is None:
+            weights = self.weights
+        raw = {env: n * w for env, w in weights.items()}
+        floors = {env: int(v) for env, v in raw.items()}
+        leftover = n - sum(floors.values())
+        # Sort by (fractional part desc, env name) for determinism.
+        fracs = sorted(
+            ((env, raw[env] - floors[env]) for env in raw),
+            key=lambda kv: (-kv[1], kv[0]),
+        )
+        for i in range(leftover):
+            env = fracs[i % len(fracs)][0]
+            floors[env] += 1
+        return floors
+
+    def draw(self, num_samples: int, *, shuffle_output: bool = True) -> List[Any]:
+        """Return ``num_samples`` Sample objects with per-env counts
+        matching the configured weights."""
+        if num_samples <= 0:
+            return []
+        # Snapshot weights once per draw so concurrent update_rewards()
+        # doesn't change the target mid-loop.
+        weights = self._snapshot_weights()
+        targets = self._compute_targets(num_samples, weights=weights)
+        drawn: List[Any] = []
+        for env, count in targets.items():
+            drawn.extend(self._draw_env(env, count))
+        # By default interleave so a downstream loop over ``drawn`` doesn't
+        # process all of env A before env B — matters if per-env state leaks
+        # across samples in the rollout engine.
+        if shuffle_output:
+            self._rng.shuffle(drawn)
+
+        # Update draw-tracking counters under the lock so get_metrics() and
+        # concurrent update_rewards() see consistent state. ``targets``
+        # already reflects what _draw_env actually returned (per-env count
+        # is exact by construction of _compute_targets + _draw_env).
+        with self._lock:
+            self._last_batch_counts = {env: int(targets.get(env, 0)) for env in self.weights}
+            for env, c in self._last_batch_counts.items():
+                self._cumulative_counts[env] = self._cumulative_counts.get(env, 0) + c
+            self._total_draws += 1
+            self._last_batch_size = int(num_samples)
+        return drawn
+
+    # ------------------------------------------------------------------
+    # Adaptive mode: reward feedback + variance-based re-weighting.
+    # ------------------------------------------------------------------
+
+    def update_rewards(self, env_rewards: Dict[str, float], rollout_id: int = 0) -> None:
+        """Feedback hook — absorb one rollout's per-env mean reward.
+
+        In static mode this is a no-op (kept as a cheap entry point so
+        callers don't need to branch on ``self.adaptive``).
+
+        In adaptive mode:
+          * updates ``ema[env] = alpha * ema[env] + (1-alpha) * reward``
+            for each env in env_rewards that is also in self.weights
+            (unknown envs are logged as warnings and skipped)
+          * increments the rollout counter
+          * if past warmup AND at least ``refresh_interval`` rollouts have
+            elapsed since the last refresh, recomputes weights from
+            variance ``p*(1-p)``, clamped to [floor, ceiling], renormalized.
+        """
+        if not self.adaptive:
+            return
+        if not isinstance(env_rewards, dict) or not env_rewards:
+            return
+
+        with self._lock:
+            # Ingest the reward signal — one EMA step per env.
+            for env, reward in env_rewards.items():
+                if env not in self._ema:
+                    logger.warning(
+                        "env_balanced_sampler.update_rewards: ignoring unknown env %r "
+                        "(not in initial weights dict; known envs: %s)",
+                        env, sorted(self._ema.keys()),
+                    )
+                    continue
+                try:
+                    r = float(reward)
+                except (TypeError, ValueError):
+                    logger.warning(
+                        "env_balanced_sampler.update_rewards: non-numeric reward %r for env %r; skipping",
+                        reward, env,
+                    )
+                    continue
+                # Clamp reward to [0,1] — the variance proxy p*(1-p) assumes
+                # a binary-reward signal. Values outside the unit interval
+                # would give negative or misleading "variance."
+                if r < 0.0:
+                    r = 0.0
+                elif r > 1.0:
+                    r = 1.0
+                prev = self._ema[env]
+                if prev is None:
+                    self._ema[env] = r
+                else:
+                    self._ema[env] = self.ema_alpha * prev + (1.0 - self.ema_alpha) * r
+
+            self._rollout_counter += 1
+
+            # Respect warmup: keep serving initial (user-provided) weights
+            # until we have warmup rollouts of EMA signal.
+            if self._rollout_counter < self.warmup:
+                return
+            if (self._rollout_counter - self._last_refresh_counter) < self.refresh_interval:
+                return
+
+            self._refresh_weights_locked()
+            self._last_refresh_counter = self._rollout_counter
+
+    @staticmethod
+    def _clamp_and_redistribute(
+        weights: Dict[str, float],
+        floor: float,
+        ceiling: float,
+    ) -> Optional[Dict[str, float]]:
+        """Project ``weights`` onto the simplex subject to per-env floor/ceiling.
+
+        Standard water-filling: repeatedly pin any env that violates a bound,
+        then rescale the unpinned envs to absorb the remaining mass. Iterates
+        to fixed point. Returns a new dict summing to 1.0, or None if no
+        feasible solution exists (which should be caught by config validation).
+        """
+        n = len(weights)
+        if n == 0:
+            return None
+        # Feasibility: floor*n <= 1 <= ceiling*n. With our defaults
+        # (floor=0.02, ceiling=0.40), this accepts up to 50 and >= 3 envs.
+        if floor * n > 1.0 + 1e-9 or ceiling * n < 1.0 - 1e-9:
+            return None
+
+        # Start with the raw weights, normalized.
+        total = sum(weights.values())
+        if total <= 0:
+            return None
+        w = {env: v / total for env, v in weights.items()}
+        pinned: Dict[str, float] = {}
+        # At most n iterations — each either pins an env or converges.
+        for _ in range(n + 1):
+            violated = [env for env, v in w.items() if v < floor - 1e-12 or v > ceiling + 1e-12]
+            if not violated:
+                out = dict(pinned)
+                out.update(w)
+                # Final defensive renormalize (should already sum to 1).
+                s = sum(out.values())
+                if s <= 0:
+                    return None
+                return {env: v / s for env, v in out.items()}
+            # Pin the most-violating env.
+            for env in violated:
+                if w[env] < floor:
+                    pinned[env] = floor
+                elif w[env] > ceiling:
+                    pinned[env] = ceiling
+                w.pop(env, None)
+            # Rescale the survivors to absorb the remaining mass.
+            remaining = 1.0 - sum(pinned.values())
+            if not w:
+                # Everything pinned — check that pinned weights sum to 1.
+                s = sum(pinned.values())
+                if abs(s - 1.0) > 1e-6 and s > 0:
+                    return {env: v / s for env, v in pinned.items()}
+                return pinned
+            if remaining <= 0:
+                # No mass left for unpinned envs — give them floor and rescale all.
+                for env in list(w.keys()):
+                    w[env] = floor
+                total_all = sum(pinned.values()) + sum(w.values())
+                if total_all <= 0:
+                    return None
+                merged = {**pinned, **w}
+                return {env: v / total_all for env, v in merged.items()}
+            scale = remaining / sum(w.values()) if sum(w.values()) > 0 else 0.0
+            w = {env: v * scale for env, v in w.items()}
+        # Didn't converge — return None so caller keeps previous weights.
+        return None
+
+    def _refresh_weights_locked(self) -> None:
+        """Recompute self.weights from current EMAs. Must be called with self._lock held."""
+        # raw_weight[env] = variance proxy = p * (1-p).
+        # If an env has no EMA signal yet, fall back to its initial weight so
+        # it doesn't get starved.
+        raw: Dict[str, float] = {}
+        for env in self.weights:
+            p = self._ema.get(env)
+            if p is None:
+                # No signal yet — preserve initial weight magnitude as a
+                # proxy. Caller's initial weights have already been normalized.
+                raw[env] = max(self._initial_weights.get(env, 0.0), 1e-9)
+            else:
+                var = p * (1.0 - p)
+                raw[env] = max(var, 1e-9)  # floor at tiny epsilon so renormalize works
+
+        total = sum(raw.values())
+        if total <= 0:
+            logger.warning(
+                "env_balanced_sampler: all variance weights collapsed to zero; "
+                "retaining previous weights"
+            )
+            return
+        new_weights = {env: v / total for env, v in raw.items()}
+
+        # Clamp to [floor, ceiling] with "water-filling" — clamp only the
+        # envs that violate the bounds, then redistribute the remaining
+        # mass proportionally to the unclamped envs. Iterate to a fixed point.
+        new_weights = self._clamp_and_redistribute(
+            new_weights, self.weight_floor, self.weight_ceiling,
+        )
+        if new_weights is None:
+            logger.warning(
+                "env_balanced_sampler: clamp+redistribute could not converge; "
+                "retaining previous weights"
+            )
+            return
+
+        logger.info(
+            "env_balanced_sampler: adaptive refresh at rollout %d — new weights: %s",
+            self._rollout_counter,
+            {env: round(w, 4) for env, w in new_weights.items()},
+        )
+        self.weights = new_weights
+        self._refreshes += 1
+
+    # ------------------------------------------------------------------
+    # WandB-facing metrics — call after each rollout, merge into the
+    # rollout's metrics dict before wandb.log(...).
+    # ------------------------------------------------------------------
+
+    def get_metrics(self) -> Dict[str, float]:
+        """Return a wandb-loggable dict of sampler state.
+
+        Keys are prefixed with ``env_sampler/`` to group in the dashboard.
+        Call after each rollout; merge into the rollout's metrics dict
+        before wandb.log().
+
+        All values are cast to ``float`` (wandb rejects ints/bools/strings
+        for scalar metrics) and all keys are flat strings — the ``/``
+        inside a key is wandb's group separator.
+        """
+        with self._lock:
+            weights_snap = dict(self.weights)
+            initial_snap = dict(self._initial_weights)
+            last_counts = dict(self._last_batch_counts)
+            cumulative = dict(self._cumulative_counts)
+            ema_snap = dict(self._ema)
+            total_draws = int(self._total_draws)
+            last_batch_size = int(self._last_batch_size)
+            rollout_counter = int(self._rollout_counter)
+            refreshes = int(self._refreshes)
+
+        metrics: Dict[str, float] = {}
+
+        # Current weights (post-adaptive). Always emitted so dashboard
+        # always has a value even when nothing has drifted.
+        for env, w in weights_snap.items():
+            metrics[f"env_sampler/weight/{env}"] = float(w)
+
+        # Initial weights (constant across the run — lets the dashboard
+        # visualize how far adaptive has drifted from the user's config).
+        for env, w in initial_snap.items():
+            metrics[f"env_sampler/initial_weight/{env}"] = float(w)
+
+        # Last-batch draw ratios + raw counts. If no draw has happened yet,
+        # both are zero for every env.
+        denom = float(last_batch_size) if last_batch_size > 0 else 0.0
+        for env in weights_snap:
+            count = int(last_counts.get(env, 0))
+            ratio = (count / denom) if denom > 0 else 0.0
+            metrics[f"env_sampler/draw_count/{env}"] = float(count)
+            metrics[f"env_sampler/draw_ratio/{env}"] = float(ratio)
+
+        # Cumulative draw ratios (lifetime fraction of samples drawn per env).
+        cum_total = float(sum(cumulative.values()))
+        for env in weights_snap:
+            c = float(cumulative.get(env, 0))
+            cum_ratio = (c / cum_total) if cum_total > 0 else 0.0
+            metrics[f"env_sampler/cumulative_ratio/{env}"] = float(cum_ratio)
+
+        # Meta counters — always emit.
+        metrics["env_sampler/total_draws"] = float(total_draws)
+        metrics["env_sampler/batch_size"] = float(last_batch_size)
+        metrics["env_sampler/adaptive"] = 1.0 if self.adaptive else 0.0
+
+        # Adaptive-only signal. In static mode we still emit them as 0.0
+        # so the dashboard doesn't go dark if someone flips modes mid-run.
+        for env in weights_snap:
+            ema = ema_snap.get(env)
+            p = float(ema) if ema is not None else 0.0
+            metrics[f"env_sampler/ema_reward/{env}"] = p
+            metrics[f"env_sampler/variance/{env}"] = float(p * (1.0 - p))
+
+        metrics["env_sampler/rollout_counter"] = float(rollout_counter)
+        metrics["env_sampler/refreshes"] = float(refreshes)
+
+        return metrics
+
+    # ------------------------------------------------------------------
+    # State save/load — optional, for checkpoint resume.
+    # ------------------------------------------------------------------
+
+    def state_dict(self) -> Dict[str, Any]:
+        with self._lock:
+            return {
+                "order": dict(self._order),
+                "offset": dict(self._offset),
+                "rng_state": self._rng.getstate(),
+                "weights": dict(self.weights),
+                "initial_weights": dict(self._initial_weights),
+                "ema": dict(self._ema),
+                "rollout_counter": int(self._rollout_counter),
+                "last_refresh_counter": int(self._last_refresh_counter),
+                "adaptive": bool(self.adaptive),
+            }
+
+    def load_state_dict(self, state: Dict[str, Any]) -> None:
+        # Only load state that matches the current config; if bucket sizes
+        # differ (new dataset), ignore and start fresh.
+        for env in self.buckets:
+            if env in state.get("order", {}) and len(state["order"][env]) == len(self.buckets[env]):
+                self._order[env] = list(state["order"][env])
+                self._offset[env] = int(state["offset"].get(env, 0))
+            else:
+                self._reshuffle(env)
+        rng_state = state.get("rng_state")
+        if rng_state is not None:
+            try:
+                self._rng.setstate(rng_state)
+            except (TypeError, ValueError):
+                logger.warning("env_balanced_sampler: ignoring incompatible saved RNG state")
+
+        # Adaptive state. Guarded so concurrent update_rewards() can't race.
+        with self._lock:
+            saved_weights = state.get("weights")
+            if isinstance(saved_weights, dict) and set(saved_weights.keys()) == set(self.weights.keys()):
+                self.weights = {env: float(w) for env, w in saved_weights.items()}
+            saved_ema = state.get("ema")
+            if isinstance(saved_ema, dict):
+                for env in self._ema:
+                    if env in saved_ema:
+                        v = saved_ema[env]
+                        self._ema[env] = None if v is None else float(v)
+            if "rollout_counter" in state:
+                try:
+                    self._rollout_counter = int(state["rollout_counter"])
+                except (TypeError, ValueError):
+                    pass
+            if "last_refresh_counter" in state:
+                try:
+                    self._last_refresh_counter = int(state["last_refresh_counter"])
+                except (TypeError, ValueError):
+                    pass
