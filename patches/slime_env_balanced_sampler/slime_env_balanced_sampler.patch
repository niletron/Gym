+# ---------------------------------------------------------------------------
+# WandB metrics: per-env draw counts, ratios, EMAs, and weight evolution.
+# ---------------------------------------------------------------------------
+
+
+class TestMetrics:
+    """The get_metrics() method is the WandB hook point. Contract:
+
+    * keys are prefixed with ``env_sampler/`` and are flat strings
+    * every value is a Python ``float`` (wandb rejects int/bool/str)
+    * every configured env appears in weight/, initial_weight/,
+      draw_ratio/, draw_count/, cumulative_ratio/
+    * adaptive-only keys (ema_reward/, variance/) are emitted as 0.0
+      in static mode so the dashboard doesn't go dark if someone
+      flips modes mid-run
+    """
+
+    def _pool(self):
+        return _make_pool({"math": 50, "code_gen": 50, "instruction_following": 50})
+
+    def _mk_static(self, **kw):
+        defaults = dict(
+            samples=self._pool(),
+            weights={"math": 0.5, "code_gen": 0.3, "instruction_following": 0.2},
+            seed=0,
+        )
+        defaults.update(kw)
+        return EnvBalancedSampler(**defaults)
+
+    def _mk_adaptive(self, **kw):
+        defaults = dict(
+            samples=self._pool(),
+            weights={"math": 1/3, "code_gen": 1/3, "instruction_following": 1/3},
+            seed=0,
+            adaptive=True,
+            ema_alpha=0.0,          # reward == latest
+            refresh_interval=1,
+            weight_floor=0.05,
+            weight_ceiling=0.80,
+            warmup=0,
+        )
+        defaults.update(kw)
+        return EnvBalancedSampler(**defaults)
+
+    def test_get_metrics_returns_all_envs(self):
+        """Every configured env must have weight/, initial_weight/,
+        draw_ratio/, draw_count/, cumulative_ratio/ entries."""
+        sampler = self._mk_static()
+        _ = sampler.draw(30)
+        m = sampler.get_metrics()
+        for env in ("math", "code_gen", "instruction_following"):
+            assert f"env_sampler/weight/{env}" in m
+            assert f"env_sampler/initial_weight/{env}" in m
+            assert f"env_sampler/draw_ratio/{env}" in m
+            assert f"env_sampler/draw_count/{env}" in m
+            assert f"env_sampler/cumulative_ratio/{env}" in m
+
+    def test_draw_ratios_sum_to_one(self):
+        sampler = self._mk_static()
+        _ = sampler.draw(30)
+        m = sampler.get_metrics()
+        total = sum(v for k, v in m.items() if k.startswith("env_sampler/draw_ratio/"))
+        assert abs(total - 1.0) < 1e-9
+
+    def test_weights_sum_to_one(self):
+        sampler = self._mk_static()
+        m = sampler.get_metrics()
+        total = sum(v for k, v in m.items() if k.startswith("env_sampler/weight/"))
+        assert abs(total - 1.0) < 1e-9
+
+    def test_initial_weights_never_change(self):
+        """After adaptive refreshes drive self.weights to a new distribution,
+        initial_weight/ keys still match the user's original input."""
+        sampler = self._mk_adaptive(
+            weights={"math": 0.1, "code_gen": 0.1, "instruction_following": 0.8},
+        )
+        # Drive adaptive to push things around.
+        for _ in range(20):
+            sampler.update_rewards({
+                "math": 0.5, "code_gen": 0.5, "instruction_following": 0.99,
+            })
+        # After refresh, IF should be much lower than 0.8.
+        assert sampler.weights["instruction_following"] < 0.5
+        m = sampler.get_metrics()
+        # ... but initial_weights are untouched. User-supplied weights are
+        # normalized at construction (0.1 + 0.1 + 0.8 = 1.0 already, so they
+        # pass through unchanged).
+        assert m["env_sampler/initial_weight/math"] == pytest.approx(0.1)
+        assert m["env_sampler/initial_weight/code_gen"] == pytest.approx(0.1)
+        assert m["env_sampler/initial_weight/instruction_following"] == pytest.approx(0.8)
+
+    def test_draw_count_matches_batch_size(self):
+        sampler = self._mk_static()
+        _ = sampler.draw(47)
+        m = sampler.get_metrics()
+        total = sum(v for k, v in m.items() if k.startswith("env_sampler/draw_count/"))
+        assert int(total) == 47
+        assert m["env_sampler/batch_size"] == 47.0
+
+    def test_cumulative_counts_track_across_batches(self):
+        """Over N batches of M samples, cumulative_ratio matches the average
+        draw ratio (which, in static mode, equals the configured weights)."""
+        sampler = self._mk_static(weights={"math": 0.5, "code_gen": 0.5})
+        pool2 = _make_pool({"math": 100, "code_gen": 100})
+        sampler = EnvBalancedSampler(pool2, {"math": 0.5, "code_gen": 0.5}, seed=0)
+        for _ in range(10):
+            sampler.draw(20)
+        m = sampler.get_metrics()
+        assert m["env_sampler/total_draws"] == 10.0
+        # 10 batches of 20 at 50/50 = 100 each. Cumulative ratio = 0.5.
+        assert m["env_sampler/cumulative_ratio/math"] == pytest.approx(0.5)
+        assert m["env_sampler/cumulative_ratio/code_gen"] == pytest.approx(0.5)
+
+    def test_ema_metrics_present_only_in_adaptive(self):
+        """In static mode: ema_reward/variance are 0.0, refreshes is 0, adaptive is 0.0.
+        In adaptive mode: they reflect the signal being fed in."""
+        # Static.
+        static = self._mk_static()
+        m = static.get_metrics()
+        assert m["env_sampler/adaptive"] == 0.0
+        assert m["env_sampler/refreshes"] == 0.0
+        for env in ("math", "code_gen", "instruction_following"):
+            assert m[f"env_sampler/ema_reward/{env}"] == 0.0
+            assert m[f"env_sampler/variance/{env}"] == 0.0
+
+        # Adaptive.
+        ad = self._mk_adaptive()
+        ad.update_rewards({"math": 0.5, "code_gen": 0.5, "instruction_following": 0.99})
+        ad.update_rewards({"math": 0.5, "code_gen": 0.5, "instruction_following": 0.99})
+        m = ad.get_metrics()
+        assert m["env_sampler/adaptive"] == 1.0
+        assert m["env_sampler/rollout_counter"] == 2.0
+        # refresh_interval=1, warmup=0 → refreshes incremented on every update.
+        assert m["env_sampler/refreshes"] >= 1.0
+        assert m["env_sampler/ema_reward/math"] == pytest.approx(0.5)
+        # variance = 0.5 * 0.5 = 0.25
+        assert m["env_sampler/variance/math"] == pytest.approx(0.25)
+        # variance at 0.99 ≈ 0.0099
+        assert m["env_sampler/variance/instruction_following"] == pytest.approx(0.99 * 0.01)
+
+    def test_metrics_returns_floats(self):
+        """wandb rejects ints/bools/strings for scalar metrics — every value
+        must be a Python ``float``."""
+        sampler = self._mk_adaptive()
+        sampler.update_rewards({"math": 0.4, "code_gen": 0.5, "instruction_following": 0.8})
+        _ = sampler.draw(30)
+        m = sampler.get_metrics()
+        # Deliberately avoid bool matching int: isinstance(True, int) is True,
+        # but not the other way around. We need plain float.
+        for k, v in m.items():
+            assert isinstance(v, float), f"{k}: expected float, got {type(v).__name__}={v!r}"
+            assert not isinstance(v, bool)  # redundant: bool is not float
+
+    def test_metrics_no_draw_yet(self):
+        """Before any draw(), draw-ratio/draw-count keys are still present
+        but zero — the dashboard doesn't have to special-case step 0."""
+        sampler = self._mk_static()
+        m = sampler.get_metrics()
+        for env in ("math", "code_gen", "instruction_following"):
+            assert m[f"env_sampler/draw_count/{env}"] == 0.0
+            assert m[f"env_sampler/draw_ratio/{env}"] == 0.0
+            assert m[f"env_sampler/cumulative_ratio/{env}"] == 0.0
+        assert m["env_sampler/total_draws"] == 0.0
+        assert m["env_sampler/batch_size"] == 0.0
+
+    def test_metrics_thread_safe(self):
+        """Concurrent draw() + update_rewards() + get_metrics() — no
+        exceptions, counts stay coherent."""
+        sampler = self._mk_adaptive(refresh_interval=2)
+        errors: List[BaseException] = []
+        stop = threading.Event()
+
+        def drawer():
+            try:
+                for _ in range(100):
+                    if stop.is_set():
+                        return
+                    sampler.draw(10)
+            except BaseException as e:  # pragma: no cover
+                errors.append(e)
+
+        def updater():
+            try:
+                for i in range(100):
+                    if stop.is_set():
+                        return
+                    sampler.update_rewards({
+                        "math": (i % 10) / 10.0,
+                        "code_gen": 0.5,
+                        "instruction_following": 0.9,
+                    }, rollout_id=i)
+            except BaseException as e:  # pragma: no cover
+                errors.append(e)
+
+        def metrics_reader():
+            try:
+                for _ in range(100):
+                    if stop.is_set():
+                        return
+                    m = sampler.get_metrics()
+                    # Keys are stable — all weights sum to 1 even mid-race.
+                    wsum = sum(v for k, v in m.items() if k.startswith("env_sampler/weight/"))
+                    assert abs(wsum - 1.0) < 1e-4, f"weight sum={wsum}"
+            except BaseException as e:  # pragma: no cover
+                errors.append(e)
+
+        threads = [
+            threading.Thread(target=drawer),
+            threading.Thread(target=updater),
+            threading.Thread(target=metrics_reader),
+            threading.Thread(target=metrics_reader),
+        ]
+        for t in threads:
+            t.start()
+        for t in threads:
