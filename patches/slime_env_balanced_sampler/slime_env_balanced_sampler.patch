+# ---------------------------------------------------------------------------
+# Adaptive EMA-variance re-weighting
+# ---------------------------------------------------------------------------
+
+
+class TestAdaptiveMode:
+    """Adaptive re-weighting driven by update_rewards() feedback.
+
+    Contract: during warmup (configured via --env-sampling-warmup), the
+    sampler uses the user-provided initial weights unchanged. Once past
+    warmup AND at least refresh_interval rollouts since last refresh,
+    weights are re-derived from per-env reward EMAs:
+      variance[env] = ema[env] * (1 - ema[env])  (binary-reward proxy)
+      weight[env]   = variance / sum(variance), clamped to [floor, ceiling].
+    """
+
+    def _pool(self):
+        # Three roughly-equal buckets, enough for many draws.
+        return _make_pool({"math": 200, "code_gen": 200, "instruction_following": 200})
+
+    def _mk_sampler(self, **kw):
+        """Construct an adaptive sampler with sane test defaults."""
+        defaults = dict(
+            samples=self._pool(),
+            weights={"math": 1/3, "code_gen": 1/3, "instruction_following": 1/3},
+            seed=0,
+            adaptive=True,
+            ema_alpha=0.5,          # fast reaction in tests
+            refresh_interval=2,
+            weight_floor=0.05,
+            weight_ceiling=0.60,
+            warmup=3,
+        )
+        defaults.update(kw)
+        return EnvBalancedSampler(**defaults)
+
+    def test_warmup_period_uses_initial_weights(self):
+        """Before warmup expires, draws reflect the user-provided initial weights."""
+        sampler = self._mk_sampler(warmup=5, refresh_interval=1, weights={
+            "math": 0.5, "code_gen": 0.25, "instruction_following": 0.25,
+        })
+        # Feed updates that WOULD reshuffle weights if adaptive were active.
+        # Warmup=5, so the first 4 updates should leave weights untouched.
+        for _ in range(4):
+            sampler.update_rewards({
+                "math": 0.2, "code_gen": 0.5, "instruction_following": 0.95,
+            })
+        drawn = sampler.draw(100)
+        counts = _count_envs(drawn)
+        # Initial weights (0.5 / 0.25 / 0.25) still in effect.
+        assert counts["math"] == 50
+        assert counts["code_gen"] == 25
+        assert counts["instruction_following"] == 25
+
+    def test_after_warmup_variance_weighting_kicks_in(self):
+        """After warmup + refresh_interval, high-variance (middle-reward) envs
+        get up-sampled and saturated envs get down-sampled."""
+        sampler = self._mk_sampler(
+            warmup=2, refresh_interval=2, ema_alpha=0.0,  # ema=0 => reward==latest
+            weight_floor=0.01, weight_ceiling=0.95,
+        )
+        # Feed a clean signal 5 rollouts in a row: instruction_following is
+        # saturated (0.95 -> variance 0.0475), math and code_gen are in the
+        # learnable middle (0.5 -> max variance 0.25).
+        for _ in range(5):
+            sampler.update_rewards({
+                "math": 0.5,
+                "code_gen": 0.5,
+                "instruction_following": 0.95,
+            })
+        weights = sampler.weights
+        # math + code_gen should dominate; IF should be much smaller.
+        assert weights["math"] > weights["instruction_following"]
+        assert weights["code_gen"] > weights["instruction_following"]
+        # Sanity: the ratio roughly matches variances 0.25 / 0.0475 ≈ 5.26.
+        # With clamping off, math/IF ~ 0.42 / 0.08 = 5.25 — very close.
+        ratio = weights["math"] / weights["instruction_following"]
+        assert 3.0 < ratio < 10.0
+
+    def test_ema_smooths_single_bad_batch(self):
+        """Single-rollout outlier should barely move weights when alpha is high."""
+        sampler = self._mk_sampler(
+            warmup=0, refresh_interval=1, ema_alpha=0.95,  # very smooth
+            weight_floor=0.01, weight_ceiling=0.95,
+        )
+        # 10 batches where math and code_gen both sit at 0.5.
+        for _ in range(10):
+            sampler.update_rewards({"math": 0.5, "code_gen": 0.5, "instruction_following": 0.5})
+        weights_before = dict(sampler.weights)
+        # One huge outlier: math crashes to 0, IF to 1.0.
+        sampler.update_rewards({"math": 0.0, "code_gen": 0.5, "instruction_following": 1.0})
+        weights_after = dict(sampler.weights)
+        # EMA at alpha=0.95 absorbs mostly the prior; movement should be small.
+        for env in weights_before:
+            delta = abs(weights_after[env] - weights_before[env])
+            assert delta < 0.05, f"{env} moved by {delta} on single outlier, too reactive"
+
+    def test_weight_floor_prevents_starvation(self):
+        """An env whose variance goes to 0 (pass rate 1.0) still gets >= floor."""
+        sampler = self._mk_sampler(
+            warmup=0, refresh_interval=1, ema_alpha=0.0,
+            weight_floor=0.10, weight_ceiling=0.80,
+        )
+        # IF fully saturated (variance 0), others in the middle.
+        for _ in range(5):
+            sampler.update_rewards({
+                "math": 0.5, "code_gen": 0.5, "instruction_following": 1.0,
+            })
+        assert sampler.weights["instruction_following"] >= 0.10 - 1e-9
+        # Sanity: weights sum to 1.
+        assert abs(sum(sampler.weights.values()) - 1.0) < 1e-6
+
+    def test_weight_ceiling_prevents_monopoly(self):
+        """A unique max-variance env can't monopolize the batch past the ceiling."""
+        sampler = self._mk_sampler(
+            warmup=0, refresh_interval=1, ema_alpha=0.0,
+            weight_floor=0.01, weight_ceiling=0.40,
+        )
+        # math alone at max variance (0.5 -> 0.25); others saturated.
+        for _ in range(5):
+            sampler.update_rewards({
+                "math": 0.5, "code_gen": 0.99, "instruction_following": 0.99,
+            })
+        assert sampler.weights["math"] <= 0.40 + 1e-9
+        assert abs(sum(sampler.weights.values()) - 1.0) < 1e-6
+
+    def test_refresh_interval_honored(self):
+        """Weights stay untouched until refresh_interval updates have accumulated past warmup."""
+        sampler = self._mk_sampler(
+            warmup=0, refresh_interval=10, ema_alpha=0.0,
+            weight_floor=0.01, weight_ceiling=0.95,
+        )
+        initial = dict(sampler.weights)
+        # Feed 5 updates — well inside refresh_interval=10, so weights must not change.
+        for _ in range(5):
+            sampler.update_rewards({
+                "math": 0.5, "code_gen": 0.5, "instruction_following": 0.99,
+            })
+        assert sampler.weights == initial
+        # Feed 5 more (now at 10 updates) — refresh fires.
+        for _ in range(5):
+            sampler.update_rewards({
+                "math": 0.5, "code_gen": 0.5, "instruction_following": 0.99,
+            })
+        assert sampler.weights != initial
+
+    def test_state_dict_includes_ema_and_rollout_count(self):
+        """Save/load preserves adaptive EMA + rollout counter + live weights."""
+        s1 = self._mk_sampler(warmup=0, refresh_interval=1, ema_alpha=0.0)
+        for _ in range(4):
+            s1.update_rewards({
+                "math": 0.5, "code_gen": 0.5, "instruction_following": 0.9,
+            })
+        state = s1.state_dict()
+        assert "ema" in state
+        assert "rollout_counter" in state
+        assert state["rollout_counter"] == 4
+        assert state["ema"]["math"] == pytest.approx(0.5)
+        assert state["ema"]["instruction_following"] == pytest.approx(0.9)
+
+        s2 = EnvBalancedSampler(
+            samples=self._pool(),
+            weights={"math": 1/3, "code_gen": 1/3, "instruction_following": 1/3},
+            seed=0,
+            adaptive=True,
+            ema_alpha=0.0,
+            refresh_interval=1,
+            weight_floor=0.05,
+            weight_ceiling=0.60,
+            warmup=0,
+        )
+        s2.load_state_dict(state)
+        assert s2._rollout_counter == 4
+        assert s2._ema["math"] == pytest.approx(0.5)
+        assert s2._ema["instruction_following"] == pytest.approx(0.9)
+        assert s2.weights == s1.weights
+
+    def test_static_mode_unchanged(self):
+        """adaptive=False: update_rewards is a no-op and weights never change."""
+        pool = _make_pool({"math": 100, "code_gen": 100})
+        sampler = EnvBalancedSampler(pool, {"math": 0.5, "code_gen": 0.5}, seed=0)
+        # Confirm adaptive defaults to off, update_rewards is a no-op.
+        assert sampler.adaptive is False
+        initial = dict(sampler.weights)
+        for _ in range(20):
+            sampler.update_rewards({"math": 0.01, "code_gen": 0.99})
+        assert sampler.weights == initial
+        # And drawing still yields the static 50/50 split.
+        drawn = sampler.draw(100)
+        counts = _count_envs(drawn)
+        assert counts["math"] == 50
+        assert counts["code_gen"] == 50
+
+    def test_update_rewards_thread_safe(self):
+        """Concurrent update + draw calls don't crash or corrupt weights."""
+        sampler = self._mk_sampler(warmup=0, refresh_interval=2, ema_alpha=0.3)
+        errors: List[BaseException] = []
+        stop = threading.Event()
+
+        def updater():
+            try:
+                for i in range(200):
+                    if stop.is_set():
+                        return
+                    sampler.update_rewards({
+                        "math": (i % 10) / 10.0,
+                        "code_gen": 0.5,
+                        "instruction_following": 0.9,
+                    }, rollout_id=i)
+            except BaseException as e:  # pragma: no cover (failure path)
+                errors.append(e)
+
+        def drawer():
+            try:
+                for _ in range(200):
+                    if stop.is_set():
+                        return
+                    out = sampler.draw(30)
+                    # Weights always sum to 1 and are non-negative.
+                    total = sum(sampler.weights.values())
+                    assert abs(total - 1.0) < 1e-4, f"weights un-normalized: total={total}"
+                    assert all(w >= 0 for w in sampler.weights.values())
+                    assert len(out) == 30
+            except BaseException as e:  # pragma: no cover (failure path)
+                errors.append(e)
+
+        threads = [threading.Thread(target=updater), threading.Thread(target=drawer),
+                   threading.Thread(target=updater), threading.Thread(target=drawer)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join(timeout=5.0)
+        stop.set()
+        assert not errors, f"concurrent execution raised: {errors}"
+
+    def test_unknown_env_in_rewards_dict_ignored(self, caplog):
+        """update_rewards({new_env: ...}) warns and skips; known envs still updated."""
+        sampler = self._mk_sampler(warmup=0, refresh_interval=1, ema_alpha=0.0)
+        with caplog.at_level(logging.WARNING):
+            sampler.update_rewards({
+                "math": 0.5,
+                "some_new_env_we_never_heard_of": 0.7,
+            })
+        # EMA updated for math, not for the unknown one.
+        assert sampler._ema["math"] == pytest.approx(0.5)
+        assert "some_new_env_we_never_heard_of" not in sampler._ema
+        assert any("unknown env" in r.message for r in caplog.records)
+
+    def test_active_sampler_registry(self):
+        """Module-level get_active_sampler() returns the last-constructed sampler."""
